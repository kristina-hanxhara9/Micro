# Azure OpenAI — two deployments under one resource.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# Deployment for the Foundry agent that does Grounding with Bing Search.
# Must be a model the BingGroundingTool supports — gpt-4o, gpt-4-turbo,
# or gpt-4. (gpt-4o-mini is NOT supported with Bing grounding.)
AZURE_OPENAI_DEPLOYMENT_AGENT=gpt-4o

# Deployment for the cheap structured-output extraction call.
AZURE_OPENAI_DEPLOYMENT_EXTRACTION=gpt-4o-mini

# Azure AI Foundry project that hosts the agent.
# Find this in Foundry portal → Project → Settings → Endpoint.
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry.services.ai.azure.com/api/projects/your-project

# Connection ID of the "Grounding with Bing Search" resource attached to your
# Foundry project. Format: /subscriptions/.../connections/<name>
BING_PROJECT_CONNECTION_ID=

# Auth: DefaultAzureCredential is used for the Foundry client (works with
# managed identity in prod, `az login` locally). The Azure OpenAI extraction
# client uses the API key above. To switch the extraction client to AAD too,
# leave AZURE_OPENAI_API_KEY blank.
