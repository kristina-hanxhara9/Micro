# Azure AI Foundry project that hosts the orchestrator agent.
# Find this in Foundry portal -> Project -> Settings -> Endpoint.
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry.services.ai.azure.com/api/projects/your-project

# Azure OpenAI resource (same resource as the deployments below).
# Used by the extraction tool for the cheap gpt-4o-mini call.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# Deployment used by the orchestrator agent (drives HostedWebSearchTool).
# Recommended: gpt-4o. gpt-4o-mini's compatibility with HostedWebSearchTool
# is not formally documented; switch to it only after verifying.
AZURE_OPENAI_DEPLOYMENT_AGENT=gpt-4o

# Deployment used by the extraction tool (cheap structured-output call).
AZURE_OPENAI_DEPLOYMENT_EXTRACTION=gpt-4o-mini

# Auth: DefaultAzureCredential is used everywhere.
#   - Production:  managed identity (no extra env vars)
#   - Local dev:   `az login` once
#
# The Foundry project must have a "Web Search" connection enabled (see
# Foundry portal -> Project -> Connected resources). HostedWebSearchTool
# uses that connection automatically; no per-call connection ID needed.
