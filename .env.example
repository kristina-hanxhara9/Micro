AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Bing Search v7 (primary by default). Optional if Google is configured.
BING_SEARCH_KEY=your-bing-search-v7-key
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Google Custom Search JSON API (fallback by default).
# Setup: https://programmablesearchengine.google.com (create engine that searches the entire web)
# + enable "Custom Search API" in Google Cloud and create an API key.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Which engine to try first: "bing" or "google". The other is the fallback.
SEARCH_PRIMARY=bing
